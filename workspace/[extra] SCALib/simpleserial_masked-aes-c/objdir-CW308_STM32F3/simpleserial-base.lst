  27:simpleserial-base.c **** /* SimpleSerial 2.1의 249바이트 프레임에는 명령 정보도 들어가므로 사용자 데�
  28:simpleserial-base.c ****  * 245바이트로 제한한다. 아래 전역 버퍼는 0x81 입력, 0x82 연산, 0x83 출력 명�
  29:simpleserial-base.c ****  * 상태를 보존한다. 호스트는 'l'에 1바이트 길이를 보내며 그 값은 MAX_DATA_L
  30:simpleserial-base.c ****  * 한다. 이 펌웨어는 잘못된 길이를 별도로 검증하지 않는다. */
  31:simpleserial-base.c **** #define MAX_DATA_LEN 245
  32:simpleserial-base.c **** #define MASK_LEN 10
  33:simpleserial-base.c **** uint8_t global_k[MAX_DATA_LEN] ={0, };
  34:simpleserial-base.c **** uint8_t global_p[MAX_DATA_LEN] ={0, };
  35:simpleserial-base.c **** uint8_t global_ret[MAX_DATA_LEN] = {0,};
  36:simpleserial-base.c **** uint8_t global_masks[MASK_LEN] = {0,};
  37:simpleserial-base.c **** uint8_t global_len = 0;
