  45:simpleserial-base.c **** /* SimpleSerial 1.1 콜백은 빌드 호환성만 유지한다. 수집기의 키·평문·길이·�
  46:simpleserial-base.c ****  * 프로토콜은 SimpleSerial 2.1의 my_init()에서만 완전하게 구현된다. */
  47:simpleserial-base.c **** uint8_t get_pt(uint8_t* pt, uint8_t len)
  48:simpleserial-base.c **** {
  49:simpleserial-base.c ****  
  50:simpleserial-base.c **** 	simpleserial_put('r', 16, pt);
  51:simpleserial-base.c **** 
  52:simpleserial-base.c **** 	return 0x00;
  53:simpleserial-base.c **** }
