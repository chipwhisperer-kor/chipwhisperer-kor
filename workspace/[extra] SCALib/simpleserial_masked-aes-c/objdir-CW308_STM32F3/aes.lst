  52:../../iut/masked-aes-c/aes.c **** // The number of columns comprising a state in AES. This is a constant in AES. Value=4
  53:../../iut/masked-aes-c/aes.c **** #define Nb 4
  54:../../iut/masked-aes-c/aes.c **** 
  55:../../iut/masked-aes-c/aes.c **** #if defined(AES256) && (AES256 == 1)
  56:../../iut/masked-aes-c/aes.c **** #define Nk 8
  57:../../iut/masked-aes-c/aes.c **** #define Nr 14
  58:../../iut/masked-aes-c/aes.c **** #elif defined(AES192) && (AES192 == 1)
  59:../../iut/masked-aes-c/aes.c **** #define Nk 6
  60:../../iut/masked-aes-c/aes.c **** #define Nr 12
  61:../../iut/masked-aes-c/aes.c **** #else
  62:../../iut/masked-aes-c/aes.c **** #define Nk 4  // The number of 32 bit words in a key.
  63:../../iut/masked-aes-c/aes.c **** #define Nr 10 // The number of rounds in AES Cipher.
  64:../../iut/masked-aes-c/aes.c **** #endif
  65:../../iut/masked-aes-c/aes.c **** 
  66:../../iut/masked-aes-c/aes.c **** // jcallan@github points out that declaring Multiply as a function
  67:../../iut/masked-aes-c/aes.c **** // reduces code size considerably with the Keil ARM compiler.
  68:../../iut/masked-aes-c/aes.c **** // See this link for more information: https://github.com/kokke/tiny-AES-C/pull/3
  69:../../iut/masked-aes-c/aes.c **** #ifndef MULTIPLY_AS_A_FUNCTION
  70:../../iut/masked-aes-c/aes.c **** #define MULTIPLY_AS_A_FUNCTION 0
  71:../../iut/masked-aes-c/aes.c **** #endif
