 306:../../iut/masked-aes-c/aes.c **** static void InitMaskingDecrypt(const uint8_t *RoundKey, uint8_t * RoundKeyMasked, uint8_t * mask)
 307:../../iut/masked-aes-c/aes.c **** {
 308:../../iut/masked-aes-c/aes.c ****   memcpy(RoundKeyMasked, RoundKey, AES_keyExpSize);
 309:../../iut/masked-aes-c/aes.c **** 
 310:../../iut/masked-aes-c/aes.c ****   /* 여기서는 srand를 호출하지 않는다. 이 타겟에서 time(NULL)은 유효한 엔트�
 311:../../iut/masked-aes-c/aes.c ****    * 아니며, 블록마다 재시드하면 오히려 마스크 수열이 반복될 수 있다. SC
 312:../../iut/masked-aes-c/aes.c ****    * 호스트는 연결 또는 재플래시 직후 SimpleSerial2 0x81 's' 명령으로 4바이트
 313:../../iut/masked-aes-c/aes.c ****    * little-endian 시드를 보내고 해당 Subset(서브셋)의 HDF5 attrs에 기록한다. 시�
 314:../../iut/masked-aes-c/aes.c ****    * 펌웨어의 고정 부팅 시드 때문에 재시작마다 같은 마스크 수열이 재생�
 315:../../iut/masked-aes-c/aes.c ****   //Randomly generate the masks: m1 m2 m3 m4 m m'
 316:../../iut/masked-aes-c/aes.c ****   for (uint8_t i = 0; i < 6; i++){
 317:../../iut/masked-aes-c/aes.c ****     /* 벤더 원본의 rand() % 0xFF는 0xFF를 절대 만들지 않아 마스크 범위를 0~254�
 318:../../iut/masked-aes-c/aes.c ****      * 줄인다. 하위 8비트를 취해 0~255 전체를 사용한다. 다만 rand()는 CSPRNG가
 319:../../iut/masked-aes-c/aes.c ****      * 아니므로 이 패치는 제품 보안을 주장하지 않으며 재현 가능한 연구 �
 320:../../iut/masked-aes-c/aes.c ****     mask[i] = rand() & 0xFF;
 321:../../iut/masked-aes-c/aes.c ****   }
 322:../../iut/masked-aes-c/aes.c **** 
 323:../../iut/masked-aes-c/aes.c ****   //Calculate m1',m2',m3',m4'
 324:../../iut/masked-aes-c/aes.c ****   calcInvMixColmask(mask);
 325:../../iut/masked-aes-c/aes.c **** 
 326:../../iut/masked-aes-c/aes.c ****   //Calculate the masked Sbox
 327:../../iut/masked-aes-c/aes.c ****   calcrSboxMasked(mask); //M' -> M
 328:../../iut/masked-aes-c/aes.c **** 
 329:../../iut/masked-aes-c/aes.c ****   //Init masked key
 330:../../iut/masked-aes-c/aes.c ****   remask((state_t *) &RoundKeyMasked[(Nr * Nb * 4)], 0, 0, 0, 0, mask[4], mask[4], mask[4], mask[4]
 331:../../iut/masked-aes-c/aes.c **** 
 332:../../iut/masked-aes-c/aes.c ****   for (int i = 0; i < Nr; i++)
 333:../../iut/masked-aes-c/aes.c ****   {
 334:../../iut/masked-aes-c/aes.c ****     remask((state_t *) &RoundKeyMasked[(i * Nb * 4)], mask[0], mask[1], mask[2], mask[3], mask[5], 
 335:../../iut/masked-aes-c/aes.c ****   }
 336:../../iut/masked-aes-c/aes.c **** 
 337:../../iut/masked-aes-c/aes.c **** #if defined(MASKED) && (MASKED == 1)
 338:../../iut/masked-aes-c/aes.c ****   memcpy(last_masks, mask, 10);
 339:../../iut/masked-aes-c/aes.c **** #endif
 340:../../iut/masked-aes-c/aes.c **** }
 341:../../iut/masked-aes-c/aes.c **** 
 342:../../iut/masked-aes-c/aes.c **** static void InitMaskingEncrypt(const uint8_t *RoundKey, uint8_t *RoundKeyMasked, uint8_t mask[10])
 343:../../iut/masked-aes-c/aes.c **** {
 344:../../iut/masked-aes-c/aes.c ****   memcpy(RoundKeyMasked, RoundKey, AES_keyExpSize);
 345:../../iut/masked-aes-c/aes.c **** 
 346:../../iut/masked-aes-c/aes.c ****   /* 여기서는 srand를 호출하지 않는다. 호스트가 연결 또는 재플래시 직후 S
 347:../../iut/masked-aes-c/aes.c ****    * 0x81 's' 명령으로 기록 가능한 시드를 주며, 시드가 없으면 고정 부팅 시
 348:../../iut/masked-aes-c/aes.c ****    * 재시작마다 같은 수열이 반복된다. 벤더 원본의 rand() % 0xFF는 0xFF를 제�
 349:../../iut/masked-aes-c/aes.c ****    * 하위 8비트를 취해 전체 바이트 범위를 사용한다. rand()는 CSPRNG가 아니�
 350:../../iut/masked-aes-c/aes.c ****    * 제품 보안이 아니라 재현 가능한 연구 수집을 위한 것이다. */
 351:../../iut/masked-aes-c/aes.c ****   //Randomly generate the masks: m1 m2 m3 m4 m m'
 352:../../iut/masked-aes-c/aes.c ****   for (uint8_t i = 0; i < 6; i++){
 353:../../iut/masked-aes-c/aes.c ****     mask[i] = rand() & 0xFF;
 354:../../iut/masked-aes-c/aes.c ****   }
 355:../../iut/masked-aes-c/aes.c **** 
 356:../../iut/masked-aes-c/aes.c ****   //Calculate m1',m2',m3',m4'
 357:../../iut/masked-aes-c/aes.c ****   calcMixColmask(mask);
 358:../../iut/masked-aes-c/aes.c **** 
 359:../../iut/masked-aes-c/aes.c ****   //Calculate the masked Sbox
 360:../../iut/masked-aes-c/aes.c ****   calcSboxMasked(mask); //m' -> m
 361:../../iut/masked-aes-c/aes.c **** 
 362:../../iut/masked-aes-c/aes.c ****   //Init masked key
 363:../../iut/masked-aes-c/aes.c ****   //	Last round mask M' to mask 0
 364:../../iut/masked-aes-c/aes.c ****   remask((state_t *) &RoundKeyMasked[(Nr * Nb * 4)], 0, 0, 0, 0, mask[5], mask[5], mask[5], mask[5]
 365:../../iut/masked-aes-c/aes.c **** 
 366:../../iut/masked-aes-c/aes.c ****   // Mask change from M1',M2',M3',M4' to M
 367:../../iut/masked-aes-c/aes.c ****   for (int i = 0; i < Nr; i++)
 368:../../iut/masked-aes-c/aes.c ****   {
 369:../../iut/masked-aes-c/aes.c ****     remask((state_t *) &RoundKeyMasked[(i * Nb * 4)], mask[6], mask[7], mask[8], mask[9], mask[4], 
 370:../../iut/masked-aes-c/aes.c ****   }
 371:../../iut/masked-aes-c/aes.c **** 
 372:../../iut/masked-aes-c/aes.c **** #if defined(MASKED) && (MASKED == 1)
 373:../../iut/masked-aes-c/aes.c ****   /* 유도 마스크(m1'..m4')까지 포함한 10바이트를 연구용으로 보관. */
 374:../../iut/masked-aes-c/aes.c ****   memcpy(last_masks, mask, 10);
 375:../../iut/masked-aes-c/aes.c **** #endif
 376:../../iut/masked-aes-c/aes.c **** }
 377:../../iut/masked-aes-c/aes.c **** 
