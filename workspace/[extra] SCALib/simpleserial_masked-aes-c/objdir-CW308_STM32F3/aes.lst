 427:../../iut/masked-aes-c/aes.c **** // This function produces Nb(Nr+1) round keys. The round keys are used in each round to decrypt the
 428:../../iut/masked-aes-c/aes.c **** static void KeyExpansion(uint8_t *RoundKey, const uint8_t *Key)
 429:../../iut/masked-aes-c/aes.c **** {
 430:../../iut/masked-aes-c/aes.c ****   unsigned i, j, k;
 431:../../iut/masked-aes-c/aes.c ****   uint8_t tempa[4]; // Used for the column/row operations
 432:../../iut/masked-aes-c/aes.c **** 
 433:../../iut/masked-aes-c/aes.c ****   // The first round key is the key itself.
 434:../../iut/masked-aes-c/aes.c ****   for (i = 0; i < Nk; ++i)
 435:../../iut/masked-aes-c/aes.c ****   {
 436:../../iut/masked-aes-c/aes.c ****     RoundKey[(i * 4) + 0] = Key[(i * 4) + 0];
 437:../../iut/masked-aes-c/aes.c ****     RoundKey[(i * 4) + 1] = Key[(i * 4) + 1];
 438:../../iut/masked-aes-c/aes.c ****     RoundKey[(i * 4) + 2] = Key[(i * 4) + 2];
 439:../../iut/masked-aes-c/aes.c ****     RoundKey[(i * 4) + 3] = Key[(i * 4) + 3];
 440:../../iut/masked-aes-c/aes.c ****   }
 441:../../iut/masked-aes-c/aes.c **** 
 442:../../iut/masked-aes-c/aes.c ****   // All other round keys are found from the previous round keys.
 443:../../iut/masked-aes-c/aes.c ****   for (i = Nk; i < Nb * (Nr + 1); ++i)
 444:../../iut/masked-aes-c/aes.c ****   {
 445:../../iut/masked-aes-c/aes.c ****     {
 446:../../iut/masked-aes-c/aes.c ****       k = (i - 1) * 4;
 447:../../iut/masked-aes-c/aes.c ****       tempa[0] = RoundKey[k + 0];
 448:../../iut/masked-aes-c/aes.c ****       tempa[1] = RoundKey[k + 1];
 449:../../iut/masked-aes-c/aes.c ****       tempa[2] = RoundKey[k + 2];
 450:../../iut/masked-aes-c/aes.c ****       tempa[3] = RoundKey[k + 3];
 451:../../iut/masked-aes-c/aes.c ****     }
 452:../../iut/masked-aes-c/aes.c **** 
 453:../../iut/masked-aes-c/aes.c ****     if (i % Nk == 0)
 454:../../iut/masked-aes-c/aes.c ****     {
 455:../../iut/masked-aes-c/aes.c ****       // This function shifts the 4 bytes in a word to the left once.
 456:../../iut/masked-aes-c/aes.c ****       // [a0,a1,a2,a3] becomes [a1,a2,a3,a0]
 457:../../iut/masked-aes-c/aes.c **** 
 458:../../iut/masked-aes-c/aes.c ****       // Function RotWord()
 459:../../iut/masked-aes-c/aes.c ****       {
 460:../../iut/masked-aes-c/aes.c ****         const uint8_t u8tmp = tempa[0];
 461:../../iut/masked-aes-c/aes.c ****         tempa[0] = tempa[1];
 462:../../iut/masked-aes-c/aes.c ****         tempa[1] = tempa[2];
 463:../../iut/masked-aes-c/aes.c ****         tempa[2] = tempa[3];
 464:../../iut/masked-aes-c/aes.c ****         tempa[3] = u8tmp;
 465:../../iut/masked-aes-c/aes.c ****       }
 466:../../iut/masked-aes-c/aes.c **** 
 467:../../iut/masked-aes-c/aes.c ****       // SubWord() is a function that takes a four-byte input word and
 468:../../iut/masked-aes-c/aes.c ****       // applies the S-box to each of the four bytes to produce an output word.
 469:../../iut/masked-aes-c/aes.c **** 
 470:../../iut/masked-aes-c/aes.c ****       // Function Subword()
 471:../../iut/masked-aes-c/aes.c ****       {
 472:../../iut/masked-aes-c/aes.c ****         tempa[0] = getSBoxValue(tempa[0]);
 473:../../iut/masked-aes-c/aes.c ****         tempa[1] = getSBoxValue(tempa[1]);
 474:../../iut/masked-aes-c/aes.c ****         tempa[2] = getSBoxValue(tempa[2]);
 475:../../iut/masked-aes-c/aes.c ****         tempa[3] = getSBoxValue(tempa[3]);
 476:../../iut/masked-aes-c/aes.c ****       }
 477:../../iut/masked-aes-c/aes.c **** 
 478:../../iut/masked-aes-c/aes.c ****       tempa[0] = tempa[0] ^ Rcon[i / Nk];
 479:../../iut/masked-aes-c/aes.c ****     }
 480:../../iut/masked-aes-c/aes.c **** #if defined(AES256) && (AES256 == 1)
 481:../../iut/masked-aes-c/aes.c ****     if (i % Nk == 4)
 482:../../iut/masked-aes-c/aes.c ****     {
 483:../../iut/masked-aes-c/aes.c ****       // Function Subword()
 484:../../iut/masked-aes-c/aes.c ****       {
 485:../../iut/masked-aes-c/aes.c ****         tempa[0] = getSBoxValue(tempa[0]);
 486:../../iut/masked-aes-c/aes.c ****         tempa[1] = getSBoxValue(tempa[1]);
 487:../../iut/masked-aes-c/aes.c ****         tempa[2] = getSBoxValue(tempa[2]);
 488:../../iut/masked-aes-c/aes.c ****         tempa[3] = getSBoxValue(tempa[3]);
 489:../../iut/masked-aes-c/aes.c ****       }
 490:../../iut/masked-aes-c/aes.c ****     }
 491:../../iut/masked-aes-c/aes.c **** #endif
 492:../../iut/masked-aes-c/aes.c ****     j = i * 4;
 493:../../iut/masked-aes-c/aes.c ****     k = (i - Nk) * 4;
 494:../../iut/masked-aes-c/aes.c ****     RoundKey[j + 0] = RoundKey[k + 0] ^ tempa[0];
 495:../../iut/masked-aes-c/aes.c ****     RoundKey[j + 1] = RoundKey[k + 1] ^ tempa[1];
 496:../../iut/masked-aes-c/aes.c ****     RoundKey[j + 2] = RoundKey[k + 2] ^ tempa[2];
 497:../../iut/masked-aes-c/aes.c ****     RoundKey[j + 3] = RoundKey[k + 3] ^ tempa[3];
 498:../../iut/masked-aes-c/aes.c ****   }
 499:../../iut/masked-aes-c/aes.c **** }
 500:../../iut/masked-aes-c/aes.c **** 
 501:../../iut/masked-aes-c/aes.c **** void AES_init_ctx(struct AES_ctx *ctx, const uint8_t *key)
 502:../../iut/masked-aes-c/aes.c **** {
 503:../../iut/masked-aes-c/aes.c ****   KeyExpansion(ctx->RoundKey, key);
 504:../../iut/masked-aes-c/aes.c **** }
 505:../../iut/masked-aes-c/aes.c **** #if (defined(CBC) && (CBC == 1)) || (defined(CTR) && (CTR == 1))
 506:../../iut/masked-aes-c/aes.c **** void AES_init_ctx_iv(struct AES_ctx *ctx, const uint8_t *key, const uint8_t *iv)
 507:../../iut/masked-aes-c/aes.c **** {
 508:../../iut/masked-aes-c/aes.c ****   KeyExpansion(ctx->RoundKey, key);
 509:../../iut/masked-aes-c/aes.c ****   memcpy(ctx->Iv, iv, AES_BLOCKLEN);
 510:../../iut/masked-aes-c/aes.c **** }
 511:../../iut/masked-aes-c/aes.c **** void AES_ctx_set_iv(struct AES_ctx *ctx, const uint8_t *iv)
 512:../../iut/masked-aes-c/aes.c **** {
 513:../../iut/masked-aes-c/aes.c ****   memcpy(ctx->Iv, iv, AES_BLOCKLEN);
 514:../../iut/masked-aes-c/aes.c **** }
 515:../../iut/masked-aes-c/aes.c **** #endif
