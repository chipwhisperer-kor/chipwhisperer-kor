 517:../../iut/masked-aes-c/aes.c **** // This function adds the round key to state.
 518:../../iut/masked-aes-c/aes.c **** // The round key is added to the state by an XOR function.
 519:../../iut/masked-aes-c/aes.c **** static void AddRoundKey(uint8_t round, state_t *state, const uint8_t *RoundKey)
 520:../../iut/masked-aes-c/aes.c **** {
 521:../../iut/masked-aes-c/aes.c ****   uint8_t i, j;
 522:../../iut/masked-aes-c/aes.c ****   for (i = 0; i < 4; ++i)
 523:../../iut/masked-aes-c/aes.c ****   {
 524:../../iut/masked-aes-c/aes.c ****     for (j = 0; j < 4; ++j)
 525:../../iut/masked-aes-c/aes.c ****     {
 526:../../iut/masked-aes-c/aes.c ****       (*state)[i][j] ^= RoundKey[(round * Nb * 4) + (i * Nb) + j];
 527:../../iut/masked-aes-c/aes.c ****     }
 528:../../iut/masked-aes-c/aes.c ****   }
 529:../../iut/masked-aes-c/aes.c **** }
 530:../../iut/masked-aes-c/aes.c **** 
 531:../../iut/masked-aes-c/aes.c **** // The SubBytes Function Substitutes the values in the
 532:../../iut/masked-aes-c/aes.c **** // state matrix with values in an S-box.
 533:../../iut/masked-aes-c/aes.c **** static void SubBytes(state_t *state)
 534:../../iut/masked-aes-c/aes.c **** {
 535:../../iut/masked-aes-c/aes.c ****   uint8_t i, j;
 536:../../iut/masked-aes-c/aes.c ****   for (i = 0; i < 4; ++i)
 537:../../iut/masked-aes-c/aes.c ****   {
 538:../../iut/masked-aes-c/aes.c ****     for (j = 0; j < 4; ++j)
 539:../../iut/masked-aes-c/aes.c ****     {
 540:../../iut/masked-aes-c/aes.c ****       (*state)[j][i] = getSBoxValue((*state)[j][i]);
 541:../../iut/masked-aes-c/aes.c ****     }
 542:../../iut/masked-aes-c/aes.c ****   }
 543:../../iut/masked-aes-c/aes.c **** }
 544:../../iut/masked-aes-c/aes.c **** 
 545:../../iut/masked-aes-c/aes.c **** // The ShiftRows() function shifts the rows in the state to the left.
 546:../../iut/masked-aes-c/aes.c **** // Each row is shifted with different offset.
 547:../../iut/masked-aes-c/aes.c **** // Offset = Row number. So the first row is not shifted.
 548:../../iut/masked-aes-c/aes.c **** static void ShiftRows(state_t *state)
 549:../../iut/masked-aes-c/aes.c **** {
 550:../../iut/masked-aes-c/aes.c ****   uint8_t temp;
 551:../../iut/masked-aes-c/aes.c **** 
 552:../../iut/masked-aes-c/aes.c ****   // Rotate first row 1 columns to left
 553:../../iut/masked-aes-c/aes.c ****   temp = (*state)[0][1];
 554:../../iut/masked-aes-c/aes.c ****   (*state)[0][1] = (*state)[1][1];
 555:../../iut/masked-aes-c/aes.c ****   (*state)[1][1] = (*state)[2][1];
 556:../../iut/masked-aes-c/aes.c ****   (*state)[2][1] = (*state)[3][1];
 557:../../iut/masked-aes-c/aes.c ****   (*state)[3][1] = temp;
 558:../../iut/masked-aes-c/aes.c **** 
 559:../../iut/masked-aes-c/aes.c ****   // Rotate second row 2 columns to left
 560:../../iut/masked-aes-c/aes.c ****   temp = (*state)[0][2];
 561:../../iut/masked-aes-c/aes.c ****   (*state)[0][2] = (*state)[2][2];
 562:../../iut/masked-aes-c/aes.c ****   (*state)[2][2] = temp;
 563:../../iut/masked-aes-c/aes.c **** 
 564:../../iut/masked-aes-c/aes.c ****   temp = (*state)[1][2];
 565:../../iut/masked-aes-c/aes.c ****   (*state)[1][2] = (*state)[3][2];
 566:../../iut/masked-aes-c/aes.c ****   (*state)[3][2] = temp;
 567:../../iut/masked-aes-c/aes.c **** 
 568:../../iut/masked-aes-c/aes.c ****   // Rotate third row 3 columns to left
 569:../../iut/masked-aes-c/aes.c ****   temp = (*state)[0][3];
 570:../../iut/masked-aes-c/aes.c ****   (*state)[0][3] = (*state)[3][3];
 571:../../iut/masked-aes-c/aes.c ****   (*state)[3][3] = (*state)[2][3];
 572:../../iut/masked-aes-c/aes.c ****   (*state)[2][3] = (*state)[1][3];
 573:../../iut/masked-aes-c/aes.c ****   (*state)[1][3] = temp;
 574:../../iut/masked-aes-c/aes.c **** }
