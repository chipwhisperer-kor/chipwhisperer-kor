 581:../../iut/masked-aes-c/aes.c **** // MixColumns function mixes the columns of the state matrix
 582:../../iut/masked-aes-c/aes.c **** static void MixColumns(state_t *state)
 583:../../iut/masked-aes-c/aes.c **** {
 584:../../iut/masked-aes-c/aes.c ****   uint8_t i;
 585:../../iut/masked-aes-c/aes.c ****   uint8_t Tmp, Tm, t;
 586:../../iut/masked-aes-c/aes.c ****   for (i = 0; i < 4; ++i)
 587:../../iut/masked-aes-c/aes.c ****   {
 588:../../iut/masked-aes-c/aes.c ****     t = (*state)[i][0];
 589:../../iut/masked-aes-c/aes.c ****     Tmp = (*state)[i][0] ^ (*state)[i][1] ^ (*state)[i][2] ^ (*state)[i][3];
 590:../../iut/masked-aes-c/aes.c ****     Tm = (*state)[i][0] ^ (*state)[i][1];
 591:../../iut/masked-aes-c/aes.c ****     Tm = xtime(Tm);
 592:../../iut/masked-aes-c/aes.c ****     (*state)[i][0] ^= Tm ^ Tmp;
 593:../../iut/masked-aes-c/aes.c ****     Tm = (*state)[i][1] ^ (*state)[i][2];
 594:../../iut/masked-aes-c/aes.c ****     Tm = xtime(Tm);
 595:../../iut/masked-aes-c/aes.c ****     (*state)[i][1] ^= Tm ^ Tmp;
 596:../../iut/masked-aes-c/aes.c ****     Tm = (*state)[i][2] ^ (*state)[i][3];
 597:../../iut/masked-aes-c/aes.c ****     Tm = xtime(Tm);
 598:../../iut/masked-aes-c/aes.c ****     (*state)[i][2] ^= Tm ^ Tmp;
 599:../../iut/masked-aes-c/aes.c ****     Tm = (*state)[i][3] ^ t;
 600:../../iut/masked-aes-c/aes.c ****     Tm = xtime(Tm);
 601:../../iut/masked-aes-c/aes.c ****     (*state)[i][3] ^= Tm ^ Tmp;
 602:../../iut/masked-aes-c/aes.c ****   }
 603:../../iut/masked-aes-c/aes.c **** }
 604:../../iut/masked-aes-c/aes.c **** 
 605:../../iut/masked-aes-c/aes.c **** // Multiply is used to multiply numbers in the field GF(2^8)
 606:../../iut/masked-aes-c/aes.c **** // Note: The last call to xtime() is unneeded, but often ends up generating a smaller binary
 607:../../iut/masked-aes-c/aes.c **** //       The compiler seems to be able to vectorize the operation better this way.
 608:../../iut/masked-aes-c/aes.c **** //       See https://github.com/kokke/tiny-AES-c/pull/34
 609:../../iut/masked-aes-c/aes.c **** #if MULTIPLY_AS_A_FUNCTION
 610:../../iut/masked-aes-c/aes.c **** static uint8_t Multiply(uint8_t x, uint8_t y)
 611:../../iut/masked-aes-c/aes.c **** {
 612:../../iut/masked-aes-c/aes.c ****   return (((y & 1) * x) ^
 613:../../iut/masked-aes-c/aes.c ****           ((y >> 1 & 1) * xtime(x)) ^
 614:../../iut/masked-aes-c/aes.c ****           ((y >> 2 & 1) * xtime(xtime(x))) ^
 615:../../iut/masked-aes-c/aes.c ****           ((y >> 3 & 1) * xtime(xtime(xtime(x)))) ^
 616:../../iut/masked-aes-c/aes.c ****           ((y >> 4 & 1) * xtime(xtime(xtime(xtime(x)))))); /* this last call to xtime() can be omit
 617:../../iut/masked-aes-c/aes.c **** }
 618:../../iut/masked-aes-c/aes.c **** #else
 619:../../iut/masked-aes-c/aes.c **** #define Multiply(x, y)                       \
 620:../../iut/masked-aes-c/aes.c ****   (((y & 1) * x) ^                           \
 621:../../iut/masked-aes-c/aes.c ****    ((y >> 1 & 1) * xtime(x)) ^               \
 622:../../iut/masked-aes-c/aes.c ****    ((y >> 2 & 1) * xtime(xtime(x))) ^        \
 623:../../iut/masked-aes-c/aes.c ****    ((y >> 3 & 1) * xtime(xtime(xtime(x)))) ^ \
 624:../../iut/masked-aes-c/aes.c ****    ((y >> 4 & 1) * xtime(xtime(xtime(xtime(x))))))
 625:../../iut/masked-aes-c/aes.c **** 
 626:../../iut/masked-aes-c/aes.c **** #endif
 627:../../iut/masked-aes-c/aes.c **** 
 628:../../iut/masked-aes-c/aes.c **** #if (defined(CBC) && CBC == 1) || (defined(ECB) && ECB == 1)
 629:../../iut/masked-aes-c/aes.c **** // MixColumns function mixes the columns of the state matrix.
 630:../../iut/masked-aes-c/aes.c **** // The method used to multiply may be difficult to understand for the inexperienced.
 631:../../iut/masked-aes-c/aes.c **** // Please use the references to gain more information.
 632:../../iut/masked-aes-c/aes.c **** static void InvMixColumns(state_t *state)
 633:../../iut/masked-aes-c/aes.c **** {
 634:../../iut/masked-aes-c/aes.c ****   int i;
 635:../../iut/masked-aes-c/aes.c ****   uint8_t a, b, c, d;
 636:../../iut/masked-aes-c/aes.c ****   for (i = 0; i < 4; ++i)
 637:../../iut/masked-aes-c/aes.c ****   {
 638:../../iut/masked-aes-c/aes.c ****     a = (*state)[i][0];
 639:../../iut/masked-aes-c/aes.c ****     b = (*state)[i][1];
 640:../../iut/masked-aes-c/aes.c ****     c = (*state)[i][2];
 641:../../iut/masked-aes-c/aes.c ****     d = (*state)[i][3];
 642:../../iut/masked-aes-c/aes.c **** 
 643:../../iut/masked-aes-c/aes.c ****     (*state)[i][0] = Multiply(a, 0x0e) ^ Multiply(b, 0x0b) ^ Multiply(c, 0x0d) ^ Multiply(d, 0x09);
 644:../../iut/masked-aes-c/aes.c ****     (*state)[i][1] = Multiply(a, 0x09) ^ Multiply(b, 0x0e) ^ Multiply(c, 0x0b) ^ Multiply(d, 0x0d);
 645:../../iut/masked-aes-c/aes.c ****     (*state)[i][2] = Multiply(a, 0x0d) ^ Multiply(b, 0x09) ^ Multiply(c, 0x0e) ^ Multiply(d, 0x0b);
 646:../../iut/masked-aes-c/aes.c ****     (*state)[i][3] = Multiply(a, 0x0b) ^ Multiply(b, 0x0d) ^ Multiply(c, 0x09) ^ Multiply(d, 0x0e);
 647:../../iut/masked-aes-c/aes.c ****   }
 648:../../iut/masked-aes-c/aes.c **** }
 649:../../iut/masked-aes-c/aes.c **** 
 650:../../iut/masked-aes-c/aes.c **** // The SubBytes Function Substitutes the values in the
 651:../../iut/masked-aes-c/aes.c **** // state matrix with values in an S-box.
 652:../../iut/masked-aes-c/aes.c **** static void InvSubBytes(state_t *state)
 653:../../iut/masked-aes-c/aes.c **** {
 654:../../iut/masked-aes-c/aes.c ****   uint8_t i, j;
 655:../../iut/masked-aes-c/aes.c ****   for (i = 0; i < 4; ++i)
 656:../../iut/masked-aes-c/aes.c ****   {
 657:../../iut/masked-aes-c/aes.c ****     for (j = 0; j < 4; ++j)
 658:../../iut/masked-aes-c/aes.c ****     {
 659:../../iut/masked-aes-c/aes.c ****       (*state)[j][i] = getSBoxInvert((*state)[j][i]);
 660:../../iut/masked-aes-c/aes.c ****     }
 661:../../iut/masked-aes-c/aes.c ****   }
 662:../../iut/masked-aes-c/aes.c **** }
 663:../../iut/masked-aes-c/aes.c **** 
 664:../../iut/masked-aes-c/aes.c **** // The SubBytes Function Substitutes the values in the
 665:../../iut/masked-aes-c/aes.c **** // state matrix with values in an S-box.
 666:../../iut/masked-aes-c/aes.c **** static void InvSubBytesMasked(state_t *state)
 667:../../iut/masked-aes-c/aes.c **** {
 668:../../iut/masked-aes-c/aes.c ****   uint8_t i, j;
 669:../../iut/masked-aes-c/aes.c ****   for (i = 0; i < 4; ++i)
 670:../../iut/masked-aes-c/aes.c ****   {
 671:../../iut/masked-aes-c/aes.c ****     for (j = 0; j < 4; ++j)
 672:../../iut/masked-aes-c/aes.c ****     {
 673:../../iut/masked-aes-c/aes.c ****       (*state)[j][i] = rSboxMasked[(*state)[j][i]];
 674:../../iut/masked-aes-c/aes.c ****     }
 675:../../iut/masked-aes-c/aes.c ****   }
 676:../../iut/masked-aes-c/aes.c **** }
 677:../../iut/masked-aes-c/aes.c **** 
 678:../../iut/masked-aes-c/aes.c **** static void InvShiftRows(state_t *state)
 679:../../iut/masked-aes-c/aes.c **** {
 680:../../iut/masked-aes-c/aes.c ****   uint8_t temp;
 681:../../iut/masked-aes-c/aes.c **** 
 682:../../iut/masked-aes-c/aes.c ****   // Rotate first row 1 columns to right
 683:../../iut/masked-aes-c/aes.c ****   temp = (*state)[3][1];
 684:../../iut/masked-aes-c/aes.c ****   (*state)[3][1] = (*state)[2][1];
 685:../../iut/masked-aes-c/aes.c ****   (*state)[2][1] = (*state)[1][1];
 686:../../iut/masked-aes-c/aes.c ****   (*state)[1][1] = (*state)[0][1];
 687:../../iut/masked-aes-c/aes.c ****   (*state)[0][1] = temp;
 688:../../iut/masked-aes-c/aes.c **** 
 689:../../iut/masked-aes-c/aes.c ****   // Rotate second row 2 columns to right
 690:../../iut/masked-aes-c/aes.c ****   temp = (*state)[0][2];
 691:../../iut/masked-aes-c/aes.c ****   (*state)[0][2] = (*state)[2][2];
 692:../../iut/masked-aes-c/aes.c ****   (*state)[2][2] = temp;
 693:../../iut/masked-aes-c/aes.c **** 
 694:../../iut/masked-aes-c/aes.c ****   temp = (*state)[1][2];
 695:../../iut/masked-aes-c/aes.c ****   (*state)[1][2] = (*state)[3][2];
 696:../../iut/masked-aes-c/aes.c ****   (*state)[3][2] = temp;
 697:../../iut/masked-aes-c/aes.c **** 
 698:../../iut/masked-aes-c/aes.c ****   // Rotate third row 3 columns to right
 699:../../iut/masked-aes-c/aes.c ****   temp = (*state)[0][3];
 700:../../iut/masked-aes-c/aes.c ****   (*state)[0][3] = (*state)[1][3];
 701:../../iut/masked-aes-c/aes.c ****   (*state)[1][3] = (*state)[2][3];
 702:../../iut/masked-aes-c/aes.c ****   (*state)[2][3] = (*state)[3][3];
 703:../../iut/masked-aes-c/aes.c ****   (*state)[3][3] = temp;
 704:../../iut/masked-aes-c/aes.c **** }
 705:../../iut/masked-aes-c/aes.c **** #endif // #if (defined(CBC) && CBC == 1) || (defined(ECB) && ECB == 1)
 706:../../iut/masked-aes-c/aes.c **** 
 707:../../iut/masked-aes-c/aes.c **** // Cipher is the main function that encrypts the PlainText.
 708:../../iut/masked-aes-c/aes.c **** static void CipherMasked(state_t *state, const uint8_t *RoundKey)
 709:../../iut/masked-aes-c/aes.c **** {
 710:../../iut/masked-aes-c/aes.c ****   uint8_t RoundKeyMasked[AES_keyExpSize] = {0};
 711:../../iut/masked-aes-c/aes.c ****   uint8_t mask[10] = {0};
 712:../../iut/masked-aes-c/aes.c ****   uint8_t round = 0;
 713:../../iut/masked-aes-c/aes.c **** 
 714:../../iut/masked-aes-c/aes.c ****   InitMaskingEncrypt(RoundKey, RoundKeyMasked, mask);
 715:../../iut/masked-aes-c/aes.c **** 
 716:../../iut/masked-aes-c/aes.c ****   //Plain text masked with m1',m2',m3',m4'
 717:../../iut/masked-aes-c/aes.c ****   remask(state, mask[6], mask[7], mask[8], mask[9], 0, 0, 0, 0);
 718:../../iut/masked-aes-c/aes.c **** 
 719:../../iut/masked-aes-c/aes.c ****   // Masks change from M1',M2',M3',M4' to M
 720:../../iut/masked-aes-c/aes.c ****   AddRoundKeyMasked(0, state, RoundKeyMasked);
 721:../../iut/masked-aes-c/aes.c ****   
 722:../../iut/masked-aes-c/aes.c ****   // There will be Nr rounds.
 723:../../iut/masked-aes-c/aes.c ****   // The first Nr-1 rounds are identical.
 724:../../iut/masked-aes-c/aes.c ****   // These Nr rounds are executed in the loop below.
 725:../../iut/masked-aes-c/aes.c ****   // Last one without MixColumns()
 726:../../iut/masked-aes-c/aes.c ****   for (round = 1;; round++)
 727:../../iut/masked-aes-c/aes.c ****   {
 728:../../iut/masked-aes-c/aes.c ****     // Mask changes from M to M'
 729:../../iut/masked-aes-c/aes.c ****     SubBytesMasked(state);
 730:../../iut/masked-aes-c/aes.c **** 
 731:../../iut/masked-aes-c/aes.c ****     //No impact on mask
 732:../../iut/masked-aes-c/aes.c ****     ShiftRows(state);
 733:../../iut/masked-aes-c/aes.c ****     if (round == Nr)
 734:../../iut/masked-aes-c/aes.c ****     {
 735:../../iut/masked-aes-c/aes.c ****       break;
 736:../../iut/masked-aes-c/aes.c ****     }
 737:../../iut/masked-aes-c/aes.c ****     //Change mask from M' to
 738:../../iut/masked-aes-c/aes.c ****     // M1 for first row
 739:../../iut/masked-aes-c/aes.c ****     // M2 for second row
 740:../../iut/masked-aes-c/aes.c ****     // M3 for third row
 741:../../iut/masked-aes-c/aes.c ****     // M4 for fourth row
 742:../../iut/masked-aes-c/aes.c ****     remask(state, mask[0], mask[1], mask[2], mask[3], mask[5], mask[5], mask[5], mask[5]);
 743:../../iut/masked-aes-c/aes.c **** 
 744:../../iut/masked-aes-c/aes.c ****     // Masks change from M1,M2,M3,M4 to M1',M2',M3',M4'
 745:../../iut/masked-aes-c/aes.c ****     MixColumns(state);
 746:../../iut/masked-aes-c/aes.c **** 
 747:../../iut/masked-aes-c/aes.c ****     // Add the First round key to the state before starting the rounds.
 748:../../iut/masked-aes-c/aes.c ****     // Masks change from M1',M2',M3',M4' to M
 749:../../iut/masked-aes-c/aes.c ****     AddRoundKeyMasked(round, state, RoundKeyMasked);
 750:../../iut/masked-aes-c/aes.c ****   }
 751:../../iut/masked-aes-c/aes.c **** 
 752:../../iut/masked-aes-c/aes.c ****   // Mask are removed by the last addroundkey
 753:../../iut/masked-aes-c/aes.c ****   // From M' to 0
 754:../../iut/masked-aes-c/aes.c ****   AddRoundKeyMasked(Nr, state, RoundKeyMasked);
 755:../../iut/masked-aes-c/aes.c **** }
 756:../../iut/masked-aes-c/aes.c **** 
 757:../../iut/masked-aes-c/aes.c **** // Cipher is the main function that encrypts the PlainText.
 758:../../iut/masked-aes-c/aes.c **** static void Cipher(state_t *state, const uint8_t *RoundKey)
 759:../../iut/masked-aes-c/aes.c **** {
 760:../../iut/masked-aes-c/aes.c ****   uint8_t round = 0;
 761:../../iut/masked-aes-c/aes.c **** 
 762:../../iut/masked-aes-c/aes.c ****   // Add the First round key to the state before starting the rounds.
 763:../../iut/masked-aes-c/aes.c ****   AddRoundKey(0, state, RoundKey);
 764:../../iut/masked-aes-c/aes.c **** 
 765:../../iut/masked-aes-c/aes.c ****   // There will be Nr rounds.
 766:../../iut/masked-aes-c/aes.c ****   // The first Nr-1 rounds are identical.
 767:../../iut/masked-aes-c/aes.c ****   // These Nr rounds are executed in the loop below.
 768:../../iut/masked-aes-c/aes.c ****   // Last one without MixColumns()
 769:../../iut/masked-aes-c/aes.c ****   for (round = 1;; ++round)
 770:../../iut/masked-aes-c/aes.c ****   {
 771:../../iut/masked-aes-c/aes.c ****     SubBytes(state);
 772:../../iut/masked-aes-c/aes.c ****     ShiftRows(state);
 773:../../iut/masked-aes-c/aes.c ****     if (round == Nr)
 774:../../iut/masked-aes-c/aes.c ****     {
 775:../../iut/masked-aes-c/aes.c ****       break;
 776:../../iut/masked-aes-c/aes.c ****     }
 777:../../iut/masked-aes-c/aes.c ****     MixColumns(state);
 778:../../iut/masked-aes-c/aes.c ****     AddRoundKey(round, state, RoundKey);
 779:../../iut/masked-aes-c/aes.c ****   }
 780:../../iut/masked-aes-c/aes.c ****   // Add round key to last round
 781:../../iut/masked-aes-c/aes.c ****   AddRoundKey(Nr, state, RoundKey);
 782:../../iut/masked-aes-c/aes.c **** }
 783:../../iut/masked-aes-c/aes.c **** 
 784:../../iut/masked-aes-c/aes.c **** #if (defined(CBC) && CBC == 1) || (defined(ECB) && ECB == 1)
 785:../../iut/masked-aes-c/aes.c **** static void InvCipherMasked(state_t *state, const uint8_t *RoundKey)
 786:../../iut/masked-aes-c/aes.c **** {
 787:../../iut/masked-aes-c/aes.c ****   uint8_t RoundKeyMasked[AES_keyExpSize] = {0};
 788:../../iut/masked-aes-c/aes.c ****   uint8_t mask[10] = {0};
 789:../../iut/masked-aes-c/aes.c ****   uint8_t round = 0;
 790:../../iut/masked-aes-c/aes.c **** 
 791:../../iut/masked-aes-c/aes.c ****   InitMaskingDecrypt(RoundKey, RoundKeyMasked, mask);
 792:../../iut/masked-aes-c/aes.c **** 
 793:../../iut/masked-aes-c/aes.c ****   // Add the First round key to the state before starting the rounds.
 794:../../iut/masked-aes-c/aes.c ****   // Mask: 0 -> M
 795:../../iut/masked-aes-c/aes.c ****   AddRoundKeyMasked(Nr, state, RoundKeyMasked);
 796:../../iut/masked-aes-c/aes.c **** 
 797:../../iut/masked-aes-c/aes.c ****   // There will be Nr rounds.
 798:../../iut/masked-aes-c/aes.c ****   // The first Nr-1 rounds are identical.
 799:../../iut/masked-aes-c/aes.c ****   // These Nr rounds are executed in the loop below.
 800:../../iut/masked-aes-c/aes.c ****   // Last one without InvMixColumn()
 801:../../iut/masked-aes-c/aes.c ****   //for (round = (Nr - 1);; --round)
 802:../../iut/masked-aes-c/aes.c ****   for (round = (Nr - 1);; --round)
 803:../../iut/masked-aes-c/aes.c ****   {
 804:../../iut/masked-aes-c/aes.c ****     //No impact on mask
 805:../../iut/masked-aes-c/aes.c ****     InvShiftRows(state);
 806:../../iut/masked-aes-c/aes.c **** 
 807:../../iut/masked-aes-c/aes.c ****     //Mask: M -> M'
 808:../../iut/masked-aes-c/aes.c ****     InvSubBytesMasked(state);
 809:../../iut/masked-aes-c/aes.c **** 
 810:../../iut/masked-aes-c/aes.c ****     // Mask: M' -> M1, M2, M3, M4
 811:../../iut/masked-aes-c/aes.c ****     AddRoundKeyMasked(round, state, RoundKeyMasked);
 812:../../iut/masked-aes-c/aes.c **** 
 813:../../iut/masked-aes-c/aes.c ****     if (round == 0)
 814:../../iut/masked-aes-c/aes.c ****     {
 815:../../iut/masked-aes-c/aes.c ****       break;
 816:../../iut/masked-aes-c/aes.c ****     }
 817:../../iut/masked-aes-c/aes.c ****     
 818:../../iut/masked-aes-c/aes.c ****     // M1,M2,M3,M4 -> M1',M2',M3',M4'
 819:../../iut/masked-aes-c/aes.c ****     InvMixColumns(state);
 820:../../iut/masked-aes-c/aes.c **** 
 821:../../iut/masked-aes-c/aes.c ****     //M1',M2',M3',M4' -> M
 822:../../iut/masked-aes-c/aes.c ****     remask(state, mask[6], mask[7], mask[8], mask[9], mask[4], mask[4], mask[4], mask[4]);
 823:../../iut/masked-aes-c/aes.c ****   }
 824:../../iut/masked-aes-c/aes.c **** 
 825:../../iut/masked-aes-c/aes.c ****   //M1,M2,M3,M4 -> 0
 826:../../iut/masked-aes-c/aes.c ****   remask(state, mask[0], mask[1], mask[2], mask[3], 0, 0, 0, 0);
 827:../../iut/masked-aes-c/aes.c **** }
 828:../../iut/masked-aes-c/aes.c **** 
 829:../../iut/masked-aes-c/aes.c **** static void InvCipher(state_t *state, const uint8_t *RoundKey)
 830:../../iut/masked-aes-c/aes.c **** {
 831:../../iut/masked-aes-c/aes.c ****   uint8_t round = 0;
 832:../../iut/masked-aes-c/aes.c **** 
 833:../../iut/masked-aes-c/aes.c ****   // Add the First round key to the state before starting the rounds.
 834:../../iut/masked-aes-c/aes.c ****   AddRoundKey(Nr, state, RoundKey);
 835:../../iut/masked-aes-c/aes.c **** 
 836:../../iut/masked-aes-c/aes.c ****   // There will be Nr rounds.
 837:../../iut/masked-aes-c/aes.c ****   // The first Nr-1 rounds are identical.
 838:../../iut/masked-aes-c/aes.c ****   // These Nr rounds are executed in the loop below.
 839:../../iut/masked-aes-c/aes.c ****   // Last one without InvMixColumn()
 840:../../iut/masked-aes-c/aes.c ****   for (round = (Nr - 1);; --round)
 841:../../iut/masked-aes-c/aes.c ****   {
 842:../../iut/masked-aes-c/aes.c ****     InvShiftRows(state);
 843:../../iut/masked-aes-c/aes.c ****     InvSubBytes(state);
 844:../../iut/masked-aes-c/aes.c ****     AddRoundKey(round, state, RoundKey);
 845:../../iut/masked-aes-c/aes.c ****     if (round == 0)
 846:../../iut/masked-aes-c/aes.c ****     {
 847:../../iut/masked-aes-c/aes.c ****       break;
 848:../../iut/masked-aes-c/aes.c ****     }
 849:../../iut/masked-aes-c/aes.c ****     InvMixColumns(state);
 850:../../iut/masked-aes-c/aes.c ****   }
 851:../../iut/masked-aes-c/aes.c **** }
 852:../../iut/masked-aes-c/aes.c **** #endif
