 228:../../iut/masked-aes-c/aes.c **** // The round constant word array, Rcon[i], contains the values given by
 229:../../iut/masked-aes-c/aes.c **** // x to the power (i-1) being powers of x (x is denoted as {02}) in the field GF(2^8)
 230:../../iut/masked-aes-c/aes.c **** static const uint8_t Rcon[11] = {
 231:../../iut/masked-aes-c/aes.c ****     0x8d, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36};
 232:../../iut/masked-aes-c/aes.c **** 
 233:../../iut/masked-aes-c/aes.c **** static uint8_t SboxMasked[256];
 234:../../iut/masked-aes-c/aes.c **** static uint8_t rSboxMasked[256];
 235:../../iut/masked-aes-c/aes.c **** 
 236:../../iut/masked-aes-c/aes.c **** /* [extra] SCALib 연구자 관점 훅: 마지막 연산의 마스크 10바이트 스냅샷.
 237:../../iut/masked-aes-c/aes.c ****  * 벤더 원본은 스택 지역변수만 써서 연산 뒤 값을 확인할 수 없다. 공격자
 238:../../iut/masked-aes-c/aes.c ****  * 분리된 HDF5 `mask` 배열 수집 및 화이트박스 진단에만 제공한다. */
 239:../../iut/masked-aes-c/aes.c **** #if defined(MASKED) && (MASKED == 1)
 240:../../iut/masked-aes-c/aes.c **** static uint8_t last_masks[10];
 241:../../iut/masked-aes-c/aes.c **** #endif
 242:../../iut/masked-aes-c/aes.c **** 
 243:../../iut/masked-aes-c/aes.c **** /*****************************************************************************/
 244:../../iut/masked-aes-c/aes.c **** /* Private functions:                                                        */
 245:../../iut/masked-aes-c/aes.c **** /*****************************************************************************/
 246:../../iut/masked-aes-c/aes.c **** /* Normal Mix Columns:
 247:../../iut/masked-aes-c/aes.c **** * [w]      [2  3  1  1]    [a]
 248:../../iut/masked-aes-c/aes.c **** * [x]  =   [1  2  3  1]  * [b]
 249:../../iut/masked-aes-c/aes.c **** * [y]      [1  1  2  3]    [c]
 250:../../iut/masked-aes-c/aes.c **** * [z]      [3  1  1  2]    [d]
 251:../../iut/masked-aes-c/aes.c **** Galois so + = XOR */
 252:../../iut/masked-aes-c/aes.c **** static void calcMixColmask(uint8_t mask[10])
 253:../../iut/masked-aes-c/aes.c **** {
 254:../../iut/masked-aes-c/aes.c ****   mask[6] = mul_02[mask[0]] ^ mul_03[mask[1]] ^ mask[2]         ^ mask[3];
 255:../../iut/masked-aes-c/aes.c ****   mask[7] = mask[0]         ^ mul_02[mask[1]] ^ mul_03[mask[2]] ^ mask[3];
 256:../../iut/masked-aes-c/aes.c ****   mask[8] = mask[0]         ^ mask[1]         ^ mul_02[mask[2]] ^ mul_03[mask[3]];
 257:../../iut/masked-aes-c/aes.c ****   mask[9] = mul_03[mask[0]] ^ mask[1]         ^ mask[2]         ^ mul_02[mask[3]];
 258:../../iut/masked-aes-c/aes.c **** }
 259:../../iut/masked-aes-c/aes.c **** 
 260:../../iut/masked-aes-c/aes.c **** /* Normal Inverse Mix Columns:
 261:../../iut/masked-aes-c/aes.c **** * [w]      [0E  0B  0D  09]    [a]
 262:../../iut/masked-aes-c/aes.c **** * [x]  =   [09  0E  0B  0D]  * [b]
 263:../../iut/masked-aes-c/aes.c **** * [y]      [0D  09  0E  0B]    [c]
 264:../../iut/masked-aes-c/aes.c **** * [z]      [0B  0D  09  0E]    [d]
 265:../../iut/masked-aes-c/aes.c **** Galois so + = XOR */
 266:../../iut/masked-aes-c/aes.c **** static void calcInvMixColmask(uint8_t mask[10])
 267:../../iut/masked-aes-c/aes.c **** {
 268:../../iut/masked-aes-c/aes.c **** 	mask[6]	=	mul_14[mask[0]]	^ mul_11[mask[1]] ^ mul_13[mask[2]]	^ mul_09[mask[3]];
 269:../../iut/masked-aes-c/aes.c **** 	mask[7]	=	mul_09[mask[0]]	^ mul_14[mask[1]]	^ mul_11[mask[2]]	^ mul_13[mask[3]];
