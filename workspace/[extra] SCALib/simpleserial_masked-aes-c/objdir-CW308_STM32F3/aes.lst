 385:../../iut/masked-aes-c/aes.c **** // The SubBytes Function Substitutes the values in the
 386:../../iut/masked-aes-c/aes.c **** // state matrix with values in an masked S-box.
 387:../../iut/masked-aes-c/aes.c **** static void SubBytesMasked(state_t *state)
 388:../../iut/masked-aes-c/aes.c **** {
 389:../../iut/masked-aes-c/aes.c ****   uint8_t i, j;
