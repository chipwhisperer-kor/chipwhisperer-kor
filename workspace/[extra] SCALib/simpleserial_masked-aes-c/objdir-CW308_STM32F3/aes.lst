 290:../../iut/masked-aes-c/aes.c **** //Calculate the the invSbox to change from Mask m to Mask m'
 291:../../iut/masked-aes-c/aes.c **** static void calcSboxMasked(uint8_t mask[10])
 292:../../iut/masked-aes-c/aes.c **** {
 293:../../iut/masked-aes-c/aes.c ****   for (int i = 0; i < 256; i++){
 294:../../iut/masked-aes-c/aes.c ****     SboxMasked[i ^ mask[4]] = sbox[i] ^ mask[5];
 295:../../iut/masked-aes-c/aes.c ****   }
 296:../../iut/masked-aes-c/aes.c **** }
 297:../../iut/masked-aes-c/aes.c **** 
 298:../../iut/masked-aes-c/aes.c **** //Calculate the the invReverseSbox to change from Mask m to Mask m'
 299:../../iut/masked-aes-c/aes.c **** static void calcrSboxMasked(uint8_t mask[10])
 300:../../iut/masked-aes-c/aes.c **** {
 301:../../iut/masked-aes-c/aes.c ****   for (int i = 0; i < 256; i++){
 302:../../iut/masked-aes-c/aes.c ****     rSboxMasked[i ^ mask[4]] = rsbox[i] ^ mask[5];
 303:../../iut/masked-aes-c/aes.c ****   }
 304:../../iut/masked-aes-c/aes.c **** }
