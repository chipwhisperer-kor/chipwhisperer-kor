 249:../../iut/tiny-AES-c/aes.c **** // The SubBytes Function Substitutes the values in the
 250:../../iut/tiny-AES-c/aes.c **** // state matrix with values in an S-box.
 251:../../iut/tiny-AES-c/aes.c **** static void SubBytes(state_t* state)
 252:../../iut/tiny-AES-c/aes.c **** {
 253:../../iut/tiny-AES-c/aes.c ****   uint8_t i, j;
 254:../../iut/tiny-AES-c/aes.c ****   for (i = 0; i < 4; ++i)
 255:../../iut/tiny-AES-c/aes.c ****   {
 256:../../iut/tiny-AES-c/aes.c ****     for (j = 0; j < 4; ++j)
 257:../../iut/tiny-AES-c/aes.c ****     {
 258:../../iut/tiny-AES-c/aes.c ****       (*state)[j][i] = getSBoxValue((*state)[j][i]);
 259:../../iut/tiny-AES-c/aes.c ****     }
 260:../../iut/tiny-AES-c/aes.c ****   }
 261:../../iut/tiny-AES-c/aes.c **** }
 262:../../iut/tiny-AES-c/aes.c **** 
 263:../../iut/tiny-AES-c/aes.c **** // The ShiftRows() function shifts the rows in the state to the left.
 264:../../iut/tiny-AES-c/aes.c **** // Each row is shifted with different offset.
 265:../../iut/tiny-AES-c/aes.c **** // Offset = Row number. So the first row is not shifted.
 266:../../iut/tiny-AES-c/aes.c **** static void ShiftRows(state_t* state)
 267:../../iut/tiny-AES-c/aes.c **** {
 268:../../iut/tiny-AES-c/aes.c ****   uint8_t temp;
 269:../../iut/tiny-AES-c/aes.c **** 
 270:../../iut/tiny-AES-c/aes.c ****   // Rotate first row 1 columns to left  
 271:../../iut/tiny-AES-c/aes.c ****   temp           = (*state)[0][1];
 272:../../iut/tiny-AES-c/aes.c ****   (*state)[0][1] = (*state)[1][1];
 273:../../iut/tiny-AES-c/aes.c ****   (*state)[1][1] = (*state)[2][1];
 274:../../iut/tiny-AES-c/aes.c ****   (*state)[2][1] = (*state)[3][1];
 275:../../iut/tiny-AES-c/aes.c ****   (*state)[3][1] = temp;
 276:../../iut/tiny-AES-c/aes.c **** 
 277:../../iut/tiny-AES-c/aes.c ****   // Rotate second row 2 columns to left  
 278:../../iut/tiny-AES-c/aes.c ****   temp           = (*state)[0][2];
 279:../../iut/tiny-AES-c/aes.c ****   (*state)[0][2] = (*state)[2][2];
 280:../../iut/tiny-AES-c/aes.c ****   (*state)[2][2] = temp;
 281:../../iut/tiny-AES-c/aes.c **** 
 282:../../iut/tiny-AES-c/aes.c ****   temp           = (*state)[1][2];
 283:../../iut/tiny-AES-c/aes.c ****   (*state)[1][2] = (*state)[3][2];
 284:../../iut/tiny-AES-c/aes.c ****   (*state)[3][2] = temp;
 285:../../iut/tiny-AES-c/aes.c **** 
 286:../../iut/tiny-AES-c/aes.c ****   // Rotate third row 3 columns to left
 287:../../iut/tiny-AES-c/aes.c ****   temp           = (*state)[0][3];
 288:../../iut/tiny-AES-c/aes.c ****   (*state)[0][3] = (*state)[3][3];
 289:../../iut/tiny-AES-c/aes.c ****   (*state)[3][3] = (*state)[2][3];
 290:../../iut/tiny-AES-c/aes.c ****   (*state)[2][3] = (*state)[1][3];
 291:../../iut/tiny-AES-c/aes.c ****   (*state)[1][3] = temp;
 292:../../iut/tiny-AES-c/aes.c **** }
