  44:../../iut/tiny-AES-c/aes.c **** // The number of columns comprising a state in AES. This is a constant in AES. Value=4
  45:../../iut/tiny-AES-c/aes.c **** #define Nb 4
  46:../../iut/tiny-AES-c/aes.c **** 
  47:../../iut/tiny-AES-c/aes.c **** #if defined(AES256) && (AES256 == 1)
  48:../../iut/tiny-AES-c/aes.c ****     #define Nk 8
  49:../../iut/tiny-AES-c/aes.c ****     #define Nr 14
  50:../../iut/tiny-AES-c/aes.c **** #elif defined(AES192) && (AES192 == 1)
  51:../../iut/tiny-AES-c/aes.c ****     #define Nk 6
  52:../../iut/tiny-AES-c/aes.c ****     #define Nr 12
  53:../../iut/tiny-AES-c/aes.c **** #else
  54:../../iut/tiny-AES-c/aes.c ****     #define Nk 4        // The number of 32 bit words in a key.
  55:../../iut/tiny-AES-c/aes.c ****     #define Nr 10       // The number of rounds in AES Cipher.
  56:../../iut/tiny-AES-c/aes.c **** #endif
