 299:../../iut/tiny-AES-c/aes.c **** // MixColumns function mixes the columns of the state matrix
 300:../../iut/tiny-AES-c/aes.c **** static void MixColumns(state_t* state)
 301:../../iut/tiny-AES-c/aes.c **** {
 302:../../iut/tiny-AES-c/aes.c ****   uint8_t i;
 303:../../iut/tiny-AES-c/aes.c ****   uint8_t Tmp, Tm, t;
 304:../../iut/tiny-AES-c/aes.c ****   for (i = 0; i < 4; ++i)
 305:../../iut/tiny-AES-c/aes.c ****   {  
 306:../../iut/tiny-AES-c/aes.c ****     t   = (*state)[i][0];
 307:../../iut/tiny-AES-c/aes.c ****     Tmp = (*state)[i][0] ^ (*state)[i][1] ^ (*state)[i][2] ^ (*state)[i][3] ;
 308:../../iut/tiny-AES-c/aes.c ****     Tm  = (*state)[i][0] ^ (*state)[i][1] ; Tm = xtime(Tm);  (*state)[i][0] ^= Tm ^ Tmp ;
 309:../../iut/tiny-AES-c/aes.c ****     Tm  = (*state)[i][1] ^ (*state)[i][2] ; Tm = xtime(Tm);  (*state)[i][1] ^= Tm ^ Tmp ;
 310:../../iut/tiny-AES-c/aes.c ****     Tm  = (*state)[i][2] ^ (*state)[i][3] ; Tm = xtime(Tm);  (*state)[i][2] ^= Tm ^ Tmp ;
 311:../../iut/tiny-AES-c/aes.c ****     Tm  = (*state)[i][3] ^ t ;              Tm = xtime(Tm);  (*state)[i][3] ^= Tm ^ Tmp ;
 312:../../iut/tiny-AES-c/aes.c ****   }
 313:../../iut/tiny-AES-c/aes.c **** }
