 117:../../iut/tiny-AES-c/aes.c **** 
 118:../../iut/tiny-AES-c/aes.c **** // The round constant word array, Rcon[i], contains the values given by 
 119:../../iut/tiny-AES-c/aes.c **** // x to the power (i-1) being powers of x (x is denoted as {02}) in the field GF(2^8)
 120:../../iut/tiny-AES-c/aes.c **** static const uint8_t Rcon[11] = {
 121:../../iut/tiny-AES-c/aes.c ****   0x8d, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1b, 0x36 };
 122:../../iut/tiny-AES-c/aes.c **** 
 123:../../iut/tiny-AES-c/aes.c **** /*
 124:../../iut/tiny-AES-c/aes.c ****  * Jordan Goulder points out in PR #12 (https://github.com/kokke/tiny-AES-C/pull/12),
 125:../../iut/tiny-AES-c/aes.c ****  * that you can remove most of the elements in the Rcon array, because they are unused.
 126:../../iut/tiny-AES-c/aes.c ****  *
 127:../../iut/tiny-AES-c/aes.c ****  * From Wikipedia's article on the Rijndael key schedule @ https://en.wikipedia.org/wiki/Rijndael_k
 128:../../iut/tiny-AES-c/aes.c ****  * 
 129:../../iut/tiny-AES-c/aes.c ****  * "Only the first some of these constants are actually used – up to rcon[10] for AES-128 (as 11 
 130:../../iut/tiny-AES-c/aes.c ****  *  up to rcon[8] for AES-192, up to rcon[7] for AES-256. rcon[0] is not used in AES algorithm."
 131:../../iut/tiny-AES-c/aes.c ****  */
 132:../../iut/tiny-AES-c/aes.c **** 
 133:../../iut/tiny-AES-c/aes.c **** 
 134:../../iut/tiny-AES-c/aes.c **** /*****************************************************************************/
 135:../../iut/tiny-AES-c/aes.c **** /* Private functions:                                                        */
 136:../../iut/tiny-AES-c/aes.c **** /*****************************************************************************/
 137:../../iut/tiny-AES-c/aes.c **** /*
 138:../../iut/tiny-AES-c/aes.c **** static uint8_t getSBoxValue(uint8_t num)
 139:../../iut/tiny-AES-c/aes.c **** {
 140:../../iut/tiny-AES-c/aes.c ****   return sbox[num];
 141:../../iut/tiny-AES-c/aes.c **** }
 142:../../iut/tiny-AES-c/aes.c **** */
 143:../../iut/tiny-AES-c/aes.c **** #define getSBoxValue(num) (sbox[(num)])
 144:../../iut/tiny-AES-c/aes.c **** 
 145:../../iut/tiny-AES-c/aes.c **** // This function produces Nb(Nr+1) round keys. The round keys are used in each round to decrypt the
 146:../../iut/tiny-AES-c/aes.c **** static void KeyExpansion(uint8_t* RoundKey, const uint8_t* Key)
 147:../../iut/tiny-AES-c/aes.c **** {
 148:../../iut/tiny-AES-c/aes.c ****   unsigned i, j, k;
 149:../../iut/tiny-AES-c/aes.c ****   uint8_t tempa[4]; // Used for the column/row operations
 150:../../iut/tiny-AES-c/aes.c ****   
 151:../../iut/tiny-AES-c/aes.c ****   // The first round key is the key itself.
 152:../../iut/tiny-AES-c/aes.c ****   for (i = 0; i < Nk; ++i)
 153:../../iut/tiny-AES-c/aes.c ****   {
 154:../../iut/tiny-AES-c/aes.c ****     RoundKey[(i * 4) + 0] = Key[(i * 4) + 0];
 155:../../iut/tiny-AES-c/aes.c ****     RoundKey[(i * 4) + 1] = Key[(i * 4) + 1];
 156:../../iut/tiny-AES-c/aes.c ****     RoundKey[(i * 4) + 2] = Key[(i * 4) + 2];
 157:../../iut/tiny-AES-c/aes.c ****     RoundKey[(i * 4) + 3] = Key[(i * 4) + 3];
 158:../../iut/tiny-AES-c/aes.c ****   }
 159:../../iut/tiny-AES-c/aes.c **** 
 160:../../iut/tiny-AES-c/aes.c ****   // All other round keys are found from the previous round keys.
 161:../../iut/tiny-AES-c/aes.c ****   for (i = Nk; i < Nb * (Nr + 1); ++i)
 162:../../iut/tiny-AES-c/aes.c ****   {
 163:../../iut/tiny-AES-c/aes.c ****     {
 164:../../iut/tiny-AES-c/aes.c ****       k = (i - 1) * 4;
 165:../../iut/tiny-AES-c/aes.c ****       tempa[0]=RoundKey[k + 0];
 166:../../iut/tiny-AES-c/aes.c ****       tempa[1]=RoundKey[k + 1];
 167:../../iut/tiny-AES-c/aes.c ****       tempa[2]=RoundKey[k + 2];
 168:../../iut/tiny-AES-c/aes.c ****       tempa[3]=RoundKey[k + 3];
 169:../../iut/tiny-AES-c/aes.c **** 
 170:../../iut/tiny-AES-c/aes.c ****     }
 171:../../iut/tiny-AES-c/aes.c **** 
 172:../../iut/tiny-AES-c/aes.c ****     if (i % Nk == 0)
 173:../../iut/tiny-AES-c/aes.c ****     {
 174:../../iut/tiny-AES-c/aes.c ****       // This function shifts the 4 bytes in a word to the left once.
 175:../../iut/tiny-AES-c/aes.c ****       // [a0,a1,a2,a3] becomes [a1,a2,a3,a0]
 176:../../iut/tiny-AES-c/aes.c **** 
 177:../../iut/tiny-AES-c/aes.c ****       // Function RotWord()
 178:../../iut/tiny-AES-c/aes.c ****       {
 179:../../iut/tiny-AES-c/aes.c ****         const uint8_t u8tmp = tempa[0];
 180:../../iut/tiny-AES-c/aes.c ****         tempa[0] = tempa[1];
 181:../../iut/tiny-AES-c/aes.c ****         tempa[1] = tempa[2];
 182:../../iut/tiny-AES-c/aes.c ****         tempa[2] = tempa[3];
 183:../../iut/tiny-AES-c/aes.c ****         tempa[3] = u8tmp;
 184:../../iut/tiny-AES-c/aes.c ****       }
 185:../../iut/tiny-AES-c/aes.c **** 
 186:../../iut/tiny-AES-c/aes.c ****       // SubWord() is a function that takes a four-byte input word and 
 187:../../iut/tiny-AES-c/aes.c ****       // applies the S-box to each of the four bytes to produce an output word.
 188:../../iut/tiny-AES-c/aes.c **** 
 189:../../iut/tiny-AES-c/aes.c ****       // Function Subword()
 190:../../iut/tiny-AES-c/aes.c ****       {
 191:../../iut/tiny-AES-c/aes.c ****         tempa[0] = getSBoxValue(tempa[0]);
 192:../../iut/tiny-AES-c/aes.c ****         tempa[1] = getSBoxValue(tempa[1]);
 193:../../iut/tiny-AES-c/aes.c ****         tempa[2] = getSBoxValue(tempa[2]);
 194:../../iut/tiny-AES-c/aes.c ****         tempa[3] = getSBoxValue(tempa[3]);
 195:../../iut/tiny-AES-c/aes.c ****       }
 196:../../iut/tiny-AES-c/aes.c **** 
 197:../../iut/tiny-AES-c/aes.c ****       tempa[0] = tempa[0] ^ Rcon[i/Nk];
 198:../../iut/tiny-AES-c/aes.c ****     }
 199:../../iut/tiny-AES-c/aes.c **** #if defined(AES256) && (AES256 == 1)
 200:../../iut/tiny-AES-c/aes.c ****     if (i % Nk == 4)
 201:../../iut/tiny-AES-c/aes.c ****     {
 202:../../iut/tiny-AES-c/aes.c ****       // Function Subword()
 203:../../iut/tiny-AES-c/aes.c ****       {
 204:../../iut/tiny-AES-c/aes.c ****         tempa[0] = getSBoxValue(tempa[0]);
 205:../../iut/tiny-AES-c/aes.c ****         tempa[1] = getSBoxValue(tempa[1]);
 206:../../iut/tiny-AES-c/aes.c ****         tempa[2] = getSBoxValue(tempa[2]);
 207:../../iut/tiny-AES-c/aes.c ****         tempa[3] = getSBoxValue(tempa[3]);
 208:../../iut/tiny-AES-c/aes.c ****       }
 209:../../iut/tiny-AES-c/aes.c ****     }
 210:../../iut/tiny-AES-c/aes.c **** #endif
