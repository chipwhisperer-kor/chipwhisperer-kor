 315:../../iut/tiny-AES-c/aes.c **** // Multiply is used to multiply numbers in the field GF(2^8)
 316:../../iut/tiny-AES-c/aes.c **** // Note: The last call to xtime() is unneeded, but often ends up generating a smaller binary
 317:../../iut/tiny-AES-c/aes.c **** //       The compiler seems to be able to vectorize the operation better this way.
 318:../../iut/tiny-AES-c/aes.c **** //       See https://github.com/kokke/tiny-AES-c/pull/34
 319:../../iut/tiny-AES-c/aes.c **** #if MULTIPLY_AS_A_FUNCTION
 320:../../iut/tiny-AES-c/aes.c **** static uint8_t Multiply(uint8_t x, uint8_t y)
 321:../../iut/tiny-AES-c/aes.c **** {
 322:../../iut/tiny-AES-c/aes.c ****   return (((y & 1) * x) ^
 323:../../iut/tiny-AES-c/aes.c ****        ((y>>1 & 1) * xtime(x)) ^
 324:../../iut/tiny-AES-c/aes.c ****        ((y>>2 & 1) * xtime(xtime(x))) ^
 325:../../iut/tiny-AES-c/aes.c ****        ((y>>3 & 1) * xtime(xtime(xtime(x)))) ^
 326:../../iut/tiny-AES-c/aes.c ****        ((y>>4 & 1) * xtime(xtime(xtime(xtime(x)))))); /* this last call to xtime() can be omitted *
 327:../../iut/tiny-AES-c/aes.c ****   }
 328:../../iut/tiny-AES-c/aes.c **** #else
 329:../../iut/tiny-AES-c/aes.c **** #define Multiply(x, y)                                \
 330:../../iut/tiny-AES-c/aes.c ****       (  ((y & 1) * x) ^                              \
 331:../../iut/tiny-AES-c/aes.c ****       ((y>>1 & 1) * xtime(x)) ^                       \
 332:../../iut/tiny-AES-c/aes.c ****       ((y>>2 & 1) * xtime(xtime(x))) ^                \
 333:../../iut/tiny-AES-c/aes.c ****       ((y>>3 & 1) * xtime(xtime(xtime(x)))) ^         \
 334:../../iut/tiny-AES-c/aes.c ****       ((y>>4 & 1) * xtime(xtime(xtime(xtime(x))))))   \
 335:../../iut/tiny-AES-c/aes.c **** 
 336:../../iut/tiny-AES-c/aes.c **** #endif
 337:../../iut/tiny-AES-c/aes.c **** 
 338:../../iut/tiny-AES-c/aes.c **** #if (defined(CBC) && CBC == 1) || (defined(ECB) && ECB == 1)
 339:../../iut/tiny-AES-c/aes.c **** /*
 340:../../iut/tiny-AES-c/aes.c **** static uint8_t getSBoxInvert(uint8_t num)
 341:../../iut/tiny-AES-c/aes.c **** {
 342:../../iut/tiny-AES-c/aes.c ****   return rsbox[num];
 343:../../iut/tiny-AES-c/aes.c **** }
 344:../../iut/tiny-AES-c/aes.c **** */
 345:../../iut/tiny-AES-c/aes.c **** #define getSBoxInvert(num) (rsbox[(num)])
 346:../../iut/tiny-AES-c/aes.c **** 
 347:../../iut/tiny-AES-c/aes.c **** // MixColumns function mixes the columns of the state matrix.
 348:../../iut/tiny-AES-c/aes.c **** // The method used to multiply may be difficult to understand for the inexperienced.
 349:../../iut/tiny-AES-c/aes.c **** // Please use the references to gain more information.
 350:../../iut/tiny-AES-c/aes.c **** static void InvMixColumns(state_t* state)
 351:../../iut/tiny-AES-c/aes.c **** {
 352:../../iut/tiny-AES-c/aes.c ****   int i;
 353:../../iut/tiny-AES-c/aes.c ****   uint8_t a, b, c, d;
 354:../../iut/tiny-AES-c/aes.c ****   for (i = 0; i < 4; ++i)
 355:../../iut/tiny-AES-c/aes.c ****   { 
 356:../../iut/tiny-AES-c/aes.c ****     a = (*state)[i][0];
 357:../../iut/tiny-AES-c/aes.c ****     b = (*state)[i][1];
 358:../../iut/tiny-AES-c/aes.c ****     c = (*state)[i][2];
 359:../../iut/tiny-AES-c/aes.c ****     d = (*state)[i][3];
 360:../../iut/tiny-AES-c/aes.c **** 
 361:../../iut/tiny-AES-c/aes.c ****     (*state)[i][0] = Multiply(a, 0x0e) ^ Multiply(b, 0x0b) ^ Multiply(c, 0x0d) ^ Multiply(d, 0x09);
 362:../../iut/tiny-AES-c/aes.c ****     (*state)[i][1] = Multiply(a, 0x09) ^ Multiply(b, 0x0e) ^ Multiply(c, 0x0b) ^ Multiply(d, 0x0d);
 363:../../iut/tiny-AES-c/aes.c ****     (*state)[i][2] = Multiply(a, 0x0d) ^ Multiply(b, 0x09) ^ Multiply(c, 0x0e) ^ Multiply(d, 0x0b);
 364:../../iut/tiny-AES-c/aes.c ****     (*state)[i][3] = Multiply(a, 0x0b) ^ Multiply(b, 0x0d) ^ Multiply(c, 0x09) ^ Multiply(d, 0x0e);
 365:../../iut/tiny-AES-c/aes.c ****   }
 366:../../iut/tiny-AES-c/aes.c **** }
 367:../../iut/tiny-AES-c/aes.c **** 
 368:../../iut/tiny-AES-c/aes.c **** 
 369:../../iut/tiny-AES-c/aes.c **** // The SubBytes Function Substitutes the values in the
 370:../../iut/tiny-AES-c/aes.c **** // state matrix with values in an S-box.
 371:../../iut/tiny-AES-c/aes.c **** static void InvSubBytes(state_t* state)
 372:../../iut/tiny-AES-c/aes.c **** {
 373:../../iut/tiny-AES-c/aes.c ****   uint8_t i, j;
 374:../../iut/tiny-AES-c/aes.c ****   for (i = 0; i < 4; ++i)
 375:../../iut/tiny-AES-c/aes.c ****   {
 376:../../iut/tiny-AES-c/aes.c ****     for (j = 0; j < 4; ++j)
 377:../../iut/tiny-AES-c/aes.c ****     {
 378:../../iut/tiny-AES-c/aes.c ****       (*state)[j][i] = getSBoxInvert((*state)[j][i]);
 379:../../iut/tiny-AES-c/aes.c ****     }
 380:../../iut/tiny-AES-c/aes.c ****   }
 381:../../iut/tiny-AES-c/aes.c **** }
 382:../../iut/tiny-AES-c/aes.c **** 
 383:../../iut/tiny-AES-c/aes.c **** static void InvShiftRows(state_t* state)
 384:../../iut/tiny-AES-c/aes.c **** {
 385:../../iut/tiny-AES-c/aes.c ****   uint8_t temp;
 386:../../iut/tiny-AES-c/aes.c **** 
 387:../../iut/tiny-AES-c/aes.c ****   // Rotate first row 1 columns to right  
 388:../../iut/tiny-AES-c/aes.c ****   temp = (*state)[3][1];
 389:../../iut/tiny-AES-c/aes.c ****   (*state)[3][1] = (*state)[2][1];
 390:../../iut/tiny-AES-c/aes.c ****   (*state)[2][1] = (*state)[1][1];
 391:../../iut/tiny-AES-c/aes.c ****   (*state)[1][1] = (*state)[0][1];
 392:../../iut/tiny-AES-c/aes.c ****   (*state)[0][1] = temp;
 393:../../iut/tiny-AES-c/aes.c **** 
 394:../../iut/tiny-AES-c/aes.c ****   // Rotate second row 2 columns to right 
 395:../../iut/tiny-AES-c/aes.c ****   temp = (*state)[0][2];
 396:../../iut/tiny-AES-c/aes.c ****   (*state)[0][2] = (*state)[2][2];
 397:../../iut/tiny-AES-c/aes.c ****   (*state)[2][2] = temp;
 398:../../iut/tiny-AES-c/aes.c **** 
 399:../../iut/tiny-AES-c/aes.c ****   temp = (*state)[1][2];
 400:../../iut/tiny-AES-c/aes.c ****   (*state)[1][2] = (*state)[3][2];
 401:../../iut/tiny-AES-c/aes.c ****   (*state)[3][2] = temp;
 402:../../iut/tiny-AES-c/aes.c **** 
 403:../../iut/tiny-AES-c/aes.c ****   // Rotate third row 3 columns to right
 404:../../iut/tiny-AES-c/aes.c ****   temp = (*state)[0][3];
 405:../../iut/tiny-AES-c/aes.c ****   (*state)[0][3] = (*state)[1][3];
 406:../../iut/tiny-AES-c/aes.c ****   (*state)[1][3] = (*state)[2][3];
 407:../../iut/tiny-AES-c/aes.c ****   (*state)[2][3] = (*state)[3][3];
 408:../../iut/tiny-AES-c/aes.c ****   (*state)[3][3] = temp;
 409:../../iut/tiny-AES-c/aes.c **** }
 410:../../iut/tiny-AES-c/aes.c **** #endif // #if (defined(CBC) && CBC == 1) || (defined(ECB) && ECB == 1)
 411:../../iut/tiny-AES-c/aes.c **** 
 412:../../iut/tiny-AES-c/aes.c **** // Cipher is the main function that encrypts the PlainText.
 413:../../iut/tiny-AES-c/aes.c **** static void Cipher(state_t* state, const uint8_t* RoundKey)
 414:../../iut/tiny-AES-c/aes.c **** {
 415:../../iut/tiny-AES-c/aes.c ****   uint8_t round = 0;
 416:../../iut/tiny-AES-c/aes.c **** 
 417:../../iut/tiny-AES-c/aes.c ****   // Add the First round key to the state before starting the rounds.
 418:../../iut/tiny-AES-c/aes.c ****   AddRoundKey(0, state, RoundKey);
 419:../../iut/tiny-AES-c/aes.c **** 
 420:../../iut/tiny-AES-c/aes.c ****   // There will be Nr rounds.
 421:../../iut/tiny-AES-c/aes.c ****   // The first Nr-1 rounds are identical.
 422:../../iut/tiny-AES-c/aes.c ****   // These Nr rounds are executed in the loop below.
 423:../../iut/tiny-AES-c/aes.c ****   // Last one without MixColumns()
 424:../../iut/tiny-AES-c/aes.c ****   for (round = 1; ; ++round)
 425:../../iut/tiny-AES-c/aes.c ****   {
 426:../../iut/tiny-AES-c/aes.c ****     SubBytes(state);
 427:../../iut/tiny-AES-c/aes.c ****     ShiftRows(state);
 428:../../iut/tiny-AES-c/aes.c ****     if (round == Nr) {
 429:../../iut/tiny-AES-c/aes.c ****       break;
 430:../../iut/tiny-AES-c/aes.c ****     }
 431:../../iut/tiny-AES-c/aes.c ****     MixColumns(state);
 432:../../iut/tiny-AES-c/aes.c ****     AddRoundKey(round, state, RoundKey);
 433:../../iut/tiny-AES-c/aes.c ****   }
 434:../../iut/tiny-AES-c/aes.c ****   // Add round key to last round
 435:../../iut/tiny-AES-c/aes.c ****   AddRoundKey(Nr, state, RoundKey);
 436:../../iut/tiny-AES-c/aes.c **** }
 437:../../iut/tiny-AES-c/aes.c **** 
 438:../../iut/tiny-AES-c/aes.c **** #if (defined(CBC) && CBC == 1) || (defined(ECB) && ECB == 1)
 439:../../iut/tiny-AES-c/aes.c **** static void InvCipher(state_t* state, const uint8_t* RoundKey)
 440:../../iut/tiny-AES-c/aes.c **** {
 441:../../iut/tiny-AES-c/aes.c ****   uint8_t round = 0;
 442:../../iut/tiny-AES-c/aes.c **** 
 443:../../iut/tiny-AES-c/aes.c ****   // Add the First round key to the state before starting the rounds.
 444:../../iut/tiny-AES-c/aes.c ****   AddRoundKey(Nr, state, RoundKey);
 445:../../iut/tiny-AES-c/aes.c **** 
 446:../../iut/tiny-AES-c/aes.c ****   // There will be Nr rounds.
 447:../../iut/tiny-AES-c/aes.c ****   // The first Nr-1 rounds are identical.
 448:../../iut/tiny-AES-c/aes.c ****   // These Nr rounds are executed in the loop below.
 449:../../iut/tiny-AES-c/aes.c ****   // Last one without InvMixColumn()
 450:../../iut/tiny-AES-c/aes.c ****   for (round = (Nr - 1); ; --round)
 451:../../iut/tiny-AES-c/aes.c ****   {
 452:../../iut/tiny-AES-c/aes.c ****     InvShiftRows(state);
 453:../../iut/tiny-AES-c/aes.c ****     InvSubBytes(state);
 454:../../iut/tiny-AES-c/aes.c ****     AddRoundKey(round, state, RoundKey);
 455:../../iut/tiny-AES-c/aes.c ****     if (round == 0) {
 456:../../iut/tiny-AES-c/aes.c ****       break;
 457:../../iut/tiny-AES-c/aes.c ****     }
 458:../../iut/tiny-AES-c/aes.c ****     InvMixColumns(state);
 459:../../iut/tiny-AES-c/aes.c ****   }
 460:../../iut/tiny-AES-c/aes.c **** 
 461:../../iut/tiny-AES-c/aes.c **** }
 462:../../iut/tiny-AES-c/aes.c **** #endif // #if (defined(CBC) && CBC == 1) || (defined(ECB) && ECB == 1)
