{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "physai/experiment_spec/2.0",
  "title": "Physical-AI-SCA v2 experiment",
  "description": "실험별 사실만 기록한다. 프로파일 기준과 단계별 수량은 physai/profiles.py에서 유도한다.",
  "type": "object",
  "required": ["schema_version", "id", "title", "assessment_profile", "campaign_stage", "algorithm", "scope", "iut", "collector", "subsets", "criteria_context", "analyses", "analysis_inputs", "seed"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "pattern": "^[0-9A-Za-z._-]+$"},
    "title": {"type": "string", "minLength": 1},
    "rationale": {"type": "string"},
    "assessment_profile": {"enum": ["iso-17825-l3", "iso-17825-l4"]},
    "campaign_stage": {"enum": ["smoke", "cw-lab-pilot", "full"]},
    "algorithm": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "required": ["standard", "assessment_type", "clauses_applied", "csp_classes", "channels", "not_claimed"],
      "additionalProperties": false,
      "properties": {
        "standard": {"const": "ISO/IEC 17825:2024"},
        "assessment_type": {"const": "pre-assessment"},
        "clauses_applied": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "csp_classes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "channels": {"type": "array", "minItems": 1, "items": {"enum": ["power", "em", "emulated-power", "debug-trace"]}},
        "not_claimed": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "iut": {
      "type": "object",
      "required": ["name", "countermeasure"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "countermeasure": {"type": "string", "minLength": 1},
        "version": {"type": "string"}
      }
    },
    "collector": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["emulation", "cw_power"]},
        "platform": {"type": "string"},
        "adc_mul": {"type": "integer", "minimum": 1},
        "gain_db": {"type": "number"},
        "bandwidth_hz": {"type": "number", "exclusiveMinimum": 0},
        "bandwidth_basis": {"type": "string", "minLength": 1},
        "bandwidth_is_nominal": {"type": "boolean"},
        "shunt_ohm": {"type": "number", "exclusiveMinimum": 0},
        "shunt_selection_note": {"type": "string", "minLength": 1},
        "shunt_max_verified": {"type": "boolean"},
        "components": {"type": "array", "items": {"enum": ["hw_reg", "hd_reg", "hw_mem", "hd_mem"]}},
        "window": {
          "type": "object",
          "required": ["from_symbol", "to_symbol"],
          "additionalProperties": false,
          "properties": {
            "from_symbol": {"type": "string"},
            "to_symbol": {"type": "string"},
            "semantics": {"type": "string"}
          }
        }
      }
    },
    "subsets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "role", "key_mode", "pt_mode"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[0-9A-Za-z_]+$"},
          "role": {"enum": ["exploration", "profiling", "attack", "leakage-detection-fixed", "leakage-detection-random", "timing", "simple-analysis"]},
          "key_mode": {"enum": ["fixed", "random"]},
          "pt_mode": {"enum": ["fixed", "random"]},
          "spa_pair_kind": {"enum": ["same-data", "different-data-fixed", "different-data-random"]}
        }
      }
    },
    "criteria_context": {
      "type": "object",
      "required": ["sensitive_leakage_time", "vendor_info"],
      "additionalProperties": false,
      "properties": {
        "sensitive_leakage_time": {
          "type": "object",
          "required": ["include_round1", "rationale"],
          "additionalProperties": false,
          "properties": {
            "from": {"type": "string"},
            "to": {"type": "string"},
            "include_round1": {"type": "boolean"},
            "rationale": {"type": "string", "minLength": 1}
          }
        },
        "vendor_info": {
          "type": "object",
          "required": ["algorithms", "design", "susceptible_conditions"],
          "additionalProperties": false,
          "properties": {
            "algorithms": {"type": "string", "minLength": 1},
            "design": {"type": "string", "minLength": 1},
            "susceptible_conditions": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "analyses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ta", "spa", "tvla", "dpa", "soundness", "snr", "cpa"]}},
    "analysis_inputs": {
      "type": "object",
      "required": ["tvla", "dpa", "cpa"],
      "additionalProperties": false,
      "properties": {
        "tvla": {"type": "object", "required": ["fixed", "random"], "additionalProperties": false, "properties": {"fixed": {"type": "string"}, "random": {"type": "string"}}},
        "dpa": {"type": "object", "required": ["subset", "target"], "additionalProperties": false, "properties": {"subset": {"type": "string"}, "target": {"type": "string"}}},
        "cpa": {"type": "object", "required": ["subset"], "additionalProperties": false, "properties": {"subset": {"type": "string"}}}
      }
    },
    "seed": {"type": "integer"}
  }
}
